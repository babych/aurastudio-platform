# =================================================================
# 🔒 Telegram Stars Inpaint Bot & Live Dashboard Configuration
# =================================================================
# Copy this file to '.env' and fill in your actual private credentials.
# NEVER commit the active '.env' file to Git!

# 1. Telegram Bot Token(s) (from @BotFather)
# You can specify a single BOT_TOKEN or a comma-separated list of BOT_TOKENS to run multiple bot instances concurrently
BOT_TOKEN=your_telegram_bot_token_here
# BOT_TOKENS=token1,token2

# 2. Super Admin Access
# Comma-separated user IDs (e.g. 123456789)
SUPER_ADMIN_IDS=123456789
# Comma-separated usernames without @ (e.g. your_username)
SUPER_ADMIN_USERNAMES=your_admin_username

# 3. Modal Cloud GPU API Endpoint
MODAL_ENDPOINT_URL=https://your-modal-app-endpoint.modal.run

# 4. Live Dashboard Port
DASHBOARD_PORT=8090

# 5. Pricing & Free Tier Limits
PRICE_STARS=10
FREE_GENERATIONS_LIMIT=5

# 6. Creative AI Studio & Magic Editor Bot (Optional standalone bot)
CREATIVE_BOT_TOKEN=your_creative_bot_token_here
CREATIVE_PORT_LOCK=49160
CREATIVE_PRICE_STARS=10
CREATIVE_FREE_LIMIT=3

# 7. Storage & Database Directory (Optional, defaults to D:\AI_Workspace\ComfyUI if present, otherwise ~/AI_Bot_Storage)
# STORAGE_DIR=D:\AI_Workspace\ComfyUI

